{
  "manifest_version": 3,
  "name": "Tallo Saver",
  "version": "1.1",
  "description": "Save images from the web to your Tallo server.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tallo-saver@example.com",
      "strict_min_version": "109.0"
    }
  }
}